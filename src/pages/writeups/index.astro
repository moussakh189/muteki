---
import Base from '../../layouts/Base.astro'
import Card from '../../components/Card.astro'
import TagPill from '../../components/TagPill.astro'
import { getCollection } from 'astro:content'
import { getReadingTime, formatDate } from '../../lib/utils'

const allWriteups = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// Collect unique CTF names and tags for filtering
const ctfNames = [...new Set(allWriteups.map((w) => w.data.ctf))].sort()
const allTags = [...new Set(allWriteups.flatMap((w) => w.data.tags))].sort()
---

<Base title="Writeups" description="CTF challenge writeups covering web security, vulnerability research, and exploitation techniques.">
  <div class="list-container">
    <header class="list-header">
      <div class="list-header-left">
        <h1 class="list-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/>
          </svg>
          Writeups
        </h1>
        <p class="list-desc">CTF challenge writeups and vulnerability research notes.</p>
      </div>
    </header>

    <!-- Filters -->
    <div class="filters" id="filters">
      <div class="filter-group">
        <span class="filter-label">Event</span>
        <button class="filter-btn filter-btn--active" data-filter-ctf="">All</button>
        {ctfNames.map((name) => (
          <button class="filter-btn" data-filter-ctf={name}>{name}</button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">Tag</span>
        <button class="filter-btn filter-btn--active" data-filter-tag="">All</button>
        {allTags.map((tag) => (
          <button class="filter-btn" data-filter-tag={tag}>{tag}</button>
        ))}
      </div>
    </div>

    <!-- Entry count -->
    <p class="results-count" id="results-count">
      <span id="visible-count">{allWriteups.length}</span> writeups
    </p>

    <!-- Grid -->
    <div class="card-grid" id="writeups-grid">
      {allWriteups.map((entry) => (
        <div
          class="card-wrapper"
          data-ctf={entry.data.ctf}
          data-tags={entry.data.tags.join(',')}
        >
          <Card
            title={entry.data.title}
            summary={entry.data.summary}
            href={`/writeups/${entry.id}`}
            date={entry.data.date}
            tags={entry.data.tags}
            collection="writeups"
            ctf={entry.data.ctf}
            readingTime={getReadingTime(entry.body)}
          />
        </div>
      ))}
    </div>
  </div>
</Base>

<script>
  let activeCtf = ''
  let activeTag = ''

  function applyFilters() {
    const wrappers = document.querySelectorAll<HTMLElement>('.card-wrapper')
    let visible = 0

    wrappers.forEach((el) => {
      const ctf = el.dataset.ctf ?? ''
      const tags = el.dataset.tags?.split(',') ?? []
      const ctfMatch = !activeCtf || ctf === activeCtf
      const tagMatch = !activeTag || tags.includes(activeTag)
      const show = ctfMatch && tagMatch
      el.style.display = show ? '' : 'none'
      if (show) visible++
    })

    const counter = document.getElementById('visible-count')
    if (counter) counter.textContent = String(visible)
  }

  function setActive(group: string, value: string) {
    if (group === 'ctf') activeCtf = value
    if (group === 'tag') activeTag = value
  }

  document.querySelectorAll<HTMLButtonElement>('[data-filter-ctf]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-filter-ctf]').forEach((b) => b.classList.remove('filter-btn--active'))
      btn.classList.add('filter-btn--active')
      setActive('ctf', btn.dataset.filterCtf ?? '')
      applyFilters()
    })
  })

  document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-filter-tag]').forEach((b) => b.classList.remove('filter-btn--active'))
      btn.classList.add('filter-btn--active')
      setActive('tag', btn.dataset.filterTag ?? '')
      applyFilters()
    })
  })
</script>

<style>
  .list-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .list-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .list-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .list-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    min-width: 36px;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-btn:hover {
    color: var(--text);
    border-color: color-mix(in oklch, var(--accent), transparent 50%);
  }
  .filter-btn--active {
    color: var(--accent);
    border-color: color-mix(in oklch, var(--accent), transparent 40%);
    background: var(--accent-muted);
  }

  .results-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
