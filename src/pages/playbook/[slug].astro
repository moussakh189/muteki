---
import { getCollection, render } from 'astro:content'
import Post from '../../layouts/Post.astro'

export async function getStaticPaths() {
  const entries = await getCollection('playbook', ({ data }) => !data.draft)
  const sorted = entries.sort((a, b) => a.data.title.localeCompare(b.data.title))

  return sorted.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevPost: sorted[index - 1]
        ? { title: sorted[index - 1].data.title, slug: sorted[index - 1].slug }
        : undefined,
      nextPost: sorted[index + 1]
        ? { title: sorted[index + 1].data.title, slug: sorted[index + 1].slug }
        : undefined,
    },
  }))
}

const { entry, prevPost, nextPost } = Astro.props
const { Content } = await render(entry)
---

<Post
  title={entry.data.title}
  tags={entry.data.tags}
  summary={entry.data.summary}
  collection="playbook"
  slug={entry.id}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</Post>
