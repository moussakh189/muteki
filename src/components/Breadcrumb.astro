---
// Icon names mapped to SVG path data (all from Lucide outline set)
type IconName = 'home' | 'book-open' | 'folder-open' | 'map' | 'file-text' | 'tag'

const icons: Record<IconName, string> = {
  'home': `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  'book-open': `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  'folder-open': `<path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/>`,
  'map': `<polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>`,
  'file-text': `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>`,
  'tag': `<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1.5"/>`,
}

interface Segment {
  label: string
  href?: string
  icon: IconName
}

interface Props {
  segments: Segment[]
}

const { segments } = Astro.props
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol role="list">
    {segments.map((seg, i) => {
      const isLast = i === segments.length - 1
      const iconPaths = icons[seg.icon]
      return (
        <li>
          {i > 0 && (
            <span class="separator" aria-hidden="true">›</span>
          )}
          <span class={`crumb ${isLast ? 'crumb--current' : ''}`}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={iconPaths}
            />
            {seg.href && !isLast ? (
              <a href={seg.href}>{seg.label}</a>
            ) : (
              <span aria-current={isLast ? 'page' : undefined}>{seg.label}</span>
            )}
          </span>
        </li>
      )
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-bottom: 0.75rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  li {
    display: flex;
    align-items: center;
  }

  .separator {
    margin: 0 0.4rem;
    color: var(--text-faint);
    user-select: none;
    font-size: 0.85rem;
  }

  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-muted);
  }

  .crumb a {
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .crumb a:hover {
    color: var(--text);
  }

  .crumb--current {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .crumb--current span {
    /* truncate long post titles on narrow screens */
    max-width: min(400px, 55vw);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: inline-block;
    vertical-align: bottom;
  }
</style>
