---
import ThemeToggle from './ThemeToggle.astro'

const navLinks = [
  { href: '/writeups', label: 'Writeups' },
  { href: '/blog', label: 'Blog' },
  { href: '/playbook', label: 'Playbook' },
  { href: '/about', label: 'About' },
]

const currentPath = Astro.url.pathname
---

<header class="site-nav">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="nav-brand magnetic" aria-label="muteki home">
      <span class="nav-wordmark">MUTEKI<span class="logo-cursor">_</span></span>
    </a>

    <ul class="nav-links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`nav-link magnetic ${currentPath.startsWith(href) ? 'nav-link--active' : ''}`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <!-- RSS link -->
      <a href="/rss.xml" class="nav-icon-btn magnetic" aria-label="RSS feed" title="RSS feed">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
      </a>

      <ThemeToggle />

      <!-- Mobile menu toggle -->
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <svg id="menu-open-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
        <svg id="menu-close-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class={`mobile-link ${currentPath.startsWith(href) ? 'mobile-link--active' : ''}`}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')!
  const menu = document.getElementById('mobile-menu')!
  const openIcon = document.getElementById('menu-open-icon')!
  const closeIcon = document.getElementById('menu-close-icon')!

  btn.addEventListener('click', () => {
    const isOpen = !menu.hidden
    menu.hidden = isOpen
    btn.setAttribute('aria-expanded', String(!isOpen))
    openIcon.style.display = isOpen ? '' : 'none'
    closeIcon.style.display = isOpen ? 'none' : ''
  })
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg), transparent 10%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-wordmark {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .logo-cursor {
    color: var(--accent);
    font-weight: 800;
    margin-left: 0.05em;
    animation: blink 1.2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  .nav-brand:hover .nav-wordmark {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    flex: 1;
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0.35rem 0.6rem;
    border-radius: 5px;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .nav-link--active {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .nav-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--text-muted);
    transition: color 0.15s, background 0.15s;
  }
  .nav-icon-btn:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    transition: color 0.15s, background 0.15s;
  }
  .mobile-menu-btn:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .mobile-menu {
    border-top: 1px solid var(--border);
    padding: 0.5rem 1.5rem 1rem;
  }
  .mobile-menu ul { list-style: none; }
  .mobile-link {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    transition: color 0.15s;
  }
  .mobile-link:hover, .mobile-link--active { color: var(--text); }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }
  }
</style>
