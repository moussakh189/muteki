---
type CollectionType = 'blog' | 'writeups' | 'playbook'

interface Props {
  title: string
  summary: string
  href: string
  date?: Date
  tags?: string[]
  readingTime?: string
  collection: CollectionType
  ctf?: string
}

import TagPill from './TagPill.astro'
import { formatDate } from '../lib/utils'

const { title, summary, href, date, tags = [], readingTime, collection, ctf } = Astro.props

// Collection badge config
const badges: Record<CollectionType, { label: string; icon: string }> = {
  blog: {
    label: 'Blog',
    icon: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  },
  writeups: {
    label: 'Writeup',
    icon: `<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>`,
  },
  playbook: {
    label: 'Playbook',
    icon: `<polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>`,
  },
}

const badge = badges[collection]
---

<article class="card">
  <a href={href} class="card-link" tabindex="-1" aria-hidden="true"></a>

  <header class="card-header">
    <div class="card-meta">
      <span class="card-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={badge.icon} />
        {badge.label}
      </span>
      {ctf && <span class="card-ctf">{ctf}</span>}
      {date && <time datetime={date.toISOString()} class="card-date">{formatDate(date)}</time>}
      {readingTime && <span class="card-read-time">{readingTime}</span>}
    </div>

    <h3 class="card-title">
      <a href={href}>{title}</a>
    </h3>
  </header>

  <p class="card-summary">{summary}</p>

  {tags.length > 0 && (
    <footer class="card-tags">
      {tags.slice(0, 4).map((tag) => <TagPill tag={tag} />)}
      {tags.length > 4 && <span class="card-tags-more">+{tags.length - 4}</span>}
    </footer>
  )}
</article>

<style>
  .card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    transition: border-color 0.15s, box-shadow 0.15s;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .card:hover {
    border-color: color-mix(in oklch, var(--accent), transparent 50%);
    box-shadow: 0 0 0 3px var(--accent-muted);
  }

  /* Make the whole card clickable */
  .card-link {
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent);
  }

  .card-ctf {
    background: var(--accent-muted);
    color: var(--accent);
    padding: 0.05em 0.45em;
    border-radius: 3px;
    border: 1px solid color-mix(in oklch, var(--accent), transparent 60%);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }

  .card-title a {
    position: relative;
    z-index: 1;
    transition: color 0.15s;
  }
  .card-title a:hover { color: var(--accent); }

  .card-summary {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.125rem;
  }

  .card-tags-more {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    align-self: center;
  }
</style>
