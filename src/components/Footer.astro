<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: auto;
    padding: 2rem 1.5rem 1.5rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: center;
  }

  .footer-link {
    font-size: 0.82rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .footer-link:hover { color: var(--text); }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--text-muted);
    transition: color 0.15s, background 0.15s;
  }
  .social-link:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.72rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
